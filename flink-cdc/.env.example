# =============================================================================
# Variaveis de ambiente opcionais do docker-compose.
# Copie para .env e ajuste APENAS se precisar dos valores de demo.
#   cp .env.example .env
# =============================================================================

# Retencao minima para as operacoes de manutencao das tabelas Iceberg no Trino
# (expire_snapshots / remove_orphan_files).
#
# DEFAULT (sem .env) = 7d  -> valor SEGURO para producao: impede apagar
#   snapshots/arquivos ainda em uso por leituras concorrentes ou time travel.
#
# Para a DEMO de manutencao (./maintenance-iceberg.sh) ter efeito imediato,
# descomente as linhas abaixo com 0s. NUNCA use 0s em producao.
#
# ICEBERG_EXPIRE_SNAPSHOTS_MIN_RETENTION=0s
# ICEBERG_REMOVE_ORPHAN_FILES_MIN_RETENTION=0s
